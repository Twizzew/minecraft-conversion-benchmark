{
  "name": "mccb-tools",
  "version": "1.3.0",
  "private": true,
  "description": "MCCB oracles: independent world readers, fixture generators, comparators and runners. They never import any converter's code.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "selftest": "node selftest/run-selftests.mjs",
    "fixtures": "node fixtures/build-fixtures.mjs",
    "evaluate": "node oracles/evaluate.mjs",
    "evaluate-suite": "node oracles/evaluate-suite.mjs",
    "manifests": "node manifests/build-manifests.mjs",
    "results": "node results/aggregate.mjs",
    "cards": "node manifests/build-world-cards.mjs",
    "freeze": "node manifests/build-freeze.mjs",
    "check": "node manifests/check-fixtures.mjs && node manifests/build-freeze.mjs --check"
  },
  "dependencies": {
    "@minecraft/vanilla-data": "1.26.40",
    "adm-zip": "0.6.1",
    "leveldb-zlib": "1.2.0",
    "prismarine-nbt": "2.8.0"
  }
}
